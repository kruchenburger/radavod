{
  "name": "radavod",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-20",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health", "/config"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "TREE", "class_name": "FamilyTree" },
      { "name": "ACCESS", "class_name": "FamilyAccess" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FamilyTree", "FamilyAccess"] }],
  "vars": {
    "APP_VERSION": "dev",
    "JURISDICTION": "eu",
    "SAMPLE": "off"
  }
}
